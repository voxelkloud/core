{
  "name": "@voxelkloud/core",
  "version": "0.1.0",
  "description": "Shared types, octree math and Potree v2 format schema for voxelkloud.",
  "license": "MIT",
  "keywords": [
    "point-cloud",
    "potree",
    "octree",
    "lidar",
    "types"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voxelkloud/core.git"
  },
  "homepage": "https://github.com/voxelkloud/voxelkloud",
  "bugs": {
    "url": "https://github.com/voxelkloud/voxelkloud/issues"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
